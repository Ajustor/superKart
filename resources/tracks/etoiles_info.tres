[gd_resource type="Resource" script_class="TrackInfo" format=3]

[ext_resource type="Script" path="res://scripts/race/track_info.gd" id="1_info"]

[resource]
script = ExtResource("1_info")
id = "etoiles"
nom = "Route des Étoiles"
description = "Une course d'une traite, de planète en planète. On quitte la base de lancement, on traverse un portail vers le canyon de la planète rouge, un cadre vers la lune de glace ; là, un puits s'ouvre dans la banquise et l'on tombe dans les nuages d'une géante gazeuse, jusqu'au dernier portail : l'arrivée est sur la station."
chemin_scene = "res://scenes/tracks/etoiles.tscn"
tours = 1
portails = true
