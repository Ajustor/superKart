[resource]
script = ExtResource("1_info")
id = "echelle_celeste"
nom = "Échelle Céleste"
description = "Une route qui monte au ciel : une hélice autour d'une tour, chaque tour au-dessus du précédent, jusqu'à 105 m ; un pont en apesanteur dans les nuages, puis la grande descente."
