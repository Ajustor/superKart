[resource]
script = ExtResource("1_info")
id = "temple_jungle"
nom = "Ruines d'Émeraude"
description = "Un fleuve qui serpente dans la jungle : la gorge à sauter au départ, trois méandres où se cache le temple, puis le retour par la piste, son couloir de marteaux et un gué où le courant emporte les karts."
chemin_scene = "res://scenes/tracks/temple_jungle.tscn"
tours = 2
