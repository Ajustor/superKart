; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]
; Un serveur exporté en release écrit ses journaux tout de suite (docker logs,
; CI) au lieu de les garder en mémoire jusqu'à sa sortie.
run/flush_stdout_on_print=true

config/name="Karting"
config/version="dev"
config/url_mises_a_jour="https://ajustor.github.io/superKart/telecharger/version.json"
config/annuaire_en_ligne="superkart.darthoit.eu"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://resources/icone/icone.svg"
config/windows_native_icon="res://resources/icone/icone.ico"

[autoload]

GameSettings="*res://scripts/core/game_settings.gd"
Reseau="*res://scripts/net/network_manager.gd"
PerfOverlay="*res://scripts/core/perf_overlay.gd"
MiseAJour="*res://scripts/core/mise_a_jour.gd"
ServeurDedie="*res://scripts/net/serveur_dedie.gd"

[debug]

file_logging/enable_file_logging.mobile=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

